/*
SCHEMA VERSION = 21

IMPORTANT: Always use singular nouns for variables and table names.
So, the names will match data Classes generated by Drift.

New to v21:
1. Move site geography into the shared `geography` table and replace the site
   geography columns with `site.geographyId`.

New to v20:
1. Add collection-event ownership to custom field values for environmental data.

New to v19:
1. Rename `weather` to `environment` and add environmental measurements.
2. Add `site.islandGroup` and move habitat fields to `siteAttribute`, which
   also adds canopy cover.
3. Replace mammal and herpetofauna age with text life stage; add life stage to
   bird and arthropod attributes.
4. Add arthropod caste and remove arthropod site and environmental fields.
5. Add fossil sex, ontogenetic stage, weight, weight unit, and remark.
*/

CREATE TABLE project (
    uuid TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL UNIQUE,
    description TEXT,
    principalInvestigator TEXT,
    accession TEXT,
    catalogNumberPrefix TEXT,
    currentCatalogNumber INT,
    catalogNumberSuffix TEXT,
    location TEXT,
    timeZone TEXT,
    startDate TEXT,
    endDate TEXT,
    created TEXT,
    lastAccessed Text
);

-- Shared, project-independent localities. Rows are deduplicated on
-- `matchKey`, the normalized form of the six geography fields.
CREATE TABLE geography (
    id INT NOT NULL PRIMARY KEY AUTOINCREMENT,
    country TEXT,
    islandGroup TEXT,
    stateProvince TEXT,
    county TEXT,
    municipality TEXT,
    locality TEXT, -- precise locality; verbatim locality in DWC
    matchKey TEXT NOT NULL UNIQUE
);

CREATE TABLE site (
    id INT NOT NULL PRIMARY KEY AUTOINCREMENT,
    siteID TEXT,
    projectUuid TEXT,
    leadStaffId TEXT,
    siteType TEXT,
    geographyId INT,
    mediaID TEXT,
    remark TEXT,
    FOREIGN KEY(geographyId) REFERENCES geography(id),
    FOREIGN KEY(mediaID) REFERENCES media(primaryId),
    FOREIGN KEY(leadStaffId) REFERENCES personnel(uuid)
);

CREATE TABLE siteAttribute (
    siteID INT,
    habitatType TEXT,
    habitatCondition TEXT,
    habitatDescription TEXT,
    canopyCover TEXT,
    FOREIGN KEY(siteID) REFERENCES site(id)
);

CREATE TABLE fossilSite (
    siteID INT,
    formation TEXT,
    geologicEra INT,
    geologicPeriod INT,
    geologicSeries INT,
    geologicEpoch INT,
    narrowerGeologicStage TEXT,
    broaderGeologicStage TEXT,
    biozone TEXT,
    rockType TEXT,
    depositionalEnvironmentType INT,
    depositionalContinent TEXT,
    depositionalMarine TEXT,
    standardPreservationType TEXT,
    stratigraphyRemark TEXT,
    stratigraphicSource TEXT,
    sedimentologyRemark TEXT,
    FOREIGN KEY(siteID) REFERENCES site(id)
);

CREATE TABLE coordinate (
    id INT UNIQUE PRIMARY KEY AUTOINCREMENT, -- internal id for easy access
    nameId TEXT, -- users assigned id.
    decimalLatitude REAL,
    decimalLongitude REAL,
    verbatimLatitude TEXT,
    verbatimLongitude TEXT,
    verbatimCoordinates TEXT,
    verbatimCoordinateSystem TEXT,
    elevationInMeter REAL,
    datum TEXT,
    uncertaintyInMeters INT,
    gpsUnit TEXT,
    notes TEXT,
    siteID INT,
    FOREIGN KEY(siteID) REFERENCES site(id)
);

CREATE TABLE collEvent (
    id INT NOT NULL PRIMARY KEY AUTOINCREMENT,
    idSuffix TEXT, -- v4 new name
    projectUuid TEXT,
    startDate TEXT,
    startTime TEXT,
    endDate TEXT,
    endTime TEXT,
    primaryCollMethod TEXT,
    collMethodNotes TEXT,
    siteID INT REFERENCES site(id),
    FOREIGN KEY(projectUuid) REFERENCES project(uuid)
);

CREATE TABLE environment (
    eventID INT,
    lowestDayTempC REAL,
    highestDayTempC REAL,
    lowestNightTempC REAL,
    highestNightTempC REAL,
    averageHumidity REAL,
    dewPointTemp REAL,
    sunriseTime TEXT,
    sunsetTime TEXT,
    moonPhase TEXT,
    cloudCover TEXT,
    rainfallInMm REAL,
    ambientTemperature REAL,
    ambientHumidity REAL,
    waterTemperature REAL,
    pH REAL,
    dissolvedOxygen REAL,
    flowVelocity REAL,
    notes TEXT,
    FOREIGN KEY(eventID) REFERENCES collEvent(id)
);

CREATE TABLE collPersonnel (
    id INT NOT NULL PRIMARY KEY AUTOINCREMENT,
    eventID INT,
    personnelId TEXT,
    name TEXT, -- we add it here to save time pulling it from personnel data
    role TEXT, -- referring to collecting role, not project role
    FOREIGN KEY(eventID) REFERENCES collEvent(id),
    FOREIGN KEY(personnelId) REFERENCES personnel(uuid)
);

CREATE TABLE collEffort (
    id INT NOT NULL PRIMARY KEY AUTOINCREMENT,
    eventID INT,
    method TEXT, -- v4 rename
    brand TEXT,
    count INT,
    size TEXT,
    notes TEXT,
    FOREIGN KEY(eventID) REFERENCES collEvent(id)
);

CREATE TABLE narrative (
    id INT NOT NULL PRIMARY KEY AUTOINCREMENT,
    projectUuid TEXT,
    date TEXT,
    time TEXT,  -- Add this new column
    siteID INT,
    writerId TEXT,
    narrative TEXT,
    mediaID INT REFERENCES media(primaryId),
    FOREIGN KEY(projectUuid) REFERENCES project(uuid),
    FOREIGN KEY(siteID) REFERENCES site(id)
);

CREATE TABLE media (
    primaryId INT NOT NULL PRIMARY KEY AUTOINCREMENT,
    projectUuid TEXT,
    secondaryId TEXT,
    category TEXT,
    tag TEXT,
    taken TEXT,
    camera TEXT,
    lenses TEXT,
    additionalExif TEXT,
    personnelId TEXT,
    fileName TEXT,
    uri TEXT,
    caption TEXT,
    FOREIGN KEY(personnelId) REFERENCES personnel(uuid),
    FOREIGN KEY(projectUuid) REFERENCES project(uuid)
);

CREATE TABLE narrativeMedia (
    narrativeId INT NOT NULL,
    mediaId INT,
    FOREIGN KEY (narrativeId) REFERENCES narrative(id),
    FOREIGN KEY (mediaId) REFERENCES media(primaryId)
);

CREATE TABLE siteMedia (
    siteId INT NOT NULL,
    mediaId INT,
    FOREIGN KEY (siteId) REFERENCES site(id),
    FOREIGN KEY (mediaId) REFERENCES media(primaryId)
);

CREATE TABLE eventMedia (
    eventID INT NOT NULL,
    mediaId INT,
    FOREIGN KEY (eventID) REFERENCES collEvent(id),
    FOREIGN KEY (mediaId) REFERENCES media(primaryId)
);

CREATE TABLE specimenMedia (
    specimenUuid TEXT NOT NULL,
    mediaId INT,
    FOREIGN KEY (specimenUuid) REFERENCES specimen(uuid),
    FOREIGN KEY (mediaId) REFERENCES media(primaryId)
);

CREATE TABLE associatedData (
    primaryId INT PRIMARY KEY AUTOINCREMENT,
    projectUuid TEXT REFERENCES project(uuid) ON DELETE CASCADE,
    name TEXT,
    type TEXT,
    date TEXT,
    description TEXT,
    uri TEXT
);

CREATE TABLE specimenAssociatedData (
    specimenUuid TEXT NOT NULL,
    associatedDataId INT NOT NULL,
    PRIMARY KEY(specimenUuid, associatedDataId),
    FOREIGN KEY(specimenUuid) REFERENCES specimen(uuid) ON DELETE CASCADE,
    FOREIGN KEY(associatedDataId) REFERENCES associatedData(primaryId)
        ON DELETE CASCADE
);

CREATE TABLE siteAssociatedData (
    siteId INT NOT NULL,
    associatedDataId INT NOT NULL,
    PRIMARY KEY(siteId, associatedDataId),
    FOREIGN KEY(siteId) REFERENCES site(id) ON DELETE CASCADE,
    FOREIGN KEY(associatedDataId) REFERENCES associatedData(primaryId)
        ON DELETE CASCADE
);

CREATE TABLE eventAssociatedData (
    eventID INT NOT NULL,
    associatedDataId INT NOT NULL,
    PRIMARY KEY(eventID, associatedDataId),
    FOREIGN KEY(eventID) REFERENCES collEvent(id) ON DELETE CASCADE,
    FOREIGN KEY(associatedDataId) REFERENCES associatedData(primaryId)
        ON DELETE CASCADE
);

CREATE TRIGGER specimen_associated_data_same_project
BEFORE INSERT ON specimenAssociatedData
BEGIN
    SELECT CASE
        WHEN (SELECT projectUuid FROM associatedData
              WHERE primaryId = NEW.associatedDataId) IS NULL
          OR (SELECT projectUuid FROM specimen
              WHERE uuid = NEW.specimenUuid) IS NULL
          OR (SELECT projectUuid FROM associatedData
              WHERE primaryId = NEW.associatedDataId)
             != (SELECT projectUuid FROM specimen
                 WHERE uuid = NEW.specimenUuid)
        THEN RAISE(ABORT, 'Associated data and specimen must share a project')
    END;
END;

CREATE TRIGGER site_associated_data_same_project
BEFORE INSERT ON siteAssociatedData
BEGIN
    SELECT CASE
        WHEN (SELECT projectUuid FROM associatedData
              WHERE primaryId = NEW.associatedDataId) IS NULL
          OR (SELECT projectUuid FROM site WHERE id = NEW.siteId) IS NULL
          OR (SELECT projectUuid FROM associatedData
              WHERE primaryId = NEW.associatedDataId)
             != (SELECT projectUuid FROM site WHERE id = NEW.siteId)
        THEN RAISE(ABORT, 'Associated data and site must share a project')
    END;
END;

CREATE TRIGGER event_associated_data_same_project
BEFORE INSERT ON eventAssociatedData
BEGIN
    SELECT CASE
        WHEN (SELECT projectUuid FROM associatedData
              WHERE primaryId = NEW.associatedDataId) IS NULL
          OR (SELECT projectUuid FROM collEvent
              WHERE id = NEW.eventID) IS NULL
          OR (SELECT projectUuid FROM associatedData
              WHERE primaryId = NEW.associatedDataId)
             != (SELECT projectUuid FROM collEvent
                 WHERE id = NEW.eventID)
        THEN RAISE(ABORT, 'Associated data and event must share a project')
    END;
END;

CREATE TABLE personnelList (
    projectUuid TEXT,
    personnelUuid TEXT,
    FOREIGN KEY(projectUuid) REFERENCES project(uuid),
    FOREIGN KEY(personnelUuid) REFERENCES personnel(uuid)
);

CREATE TABLE personnel (
    uuid TEXT UNIQUE NOT NULL PRIMARY KEY,
    name TEXT,
    initial TEXT,
    email TEXT,
    phone TEXT,
    affiliation TEXT,
    orcid TEXT,
    role TEXT,
    currentFieldNumber INT, -- the next input for field number
    notes TEXT,
    photoPath TEXT,
    isRegisterField BOOLEAN NOT NULL DEFAULT 1
);

CREATE TABLE taxonomy (
    id INT NOT NULL PRIMARY KEY AUTOINCREMENT,
    taxonRank TEXT,
    kingdom TEXT,
    phylum TEXT,
    taxonClass TEXT,
    taxonOrder TEXT,
    taxonFamily TEXT,
    genus TEXT,
    specificEpithet TEXT,
    subspecificEpithet TEXT,
    authors TEXT,
    commonName TEXT,
    notes TEXT,
    citesStatus TEXT,
    redListCategory TEXT,
    countryStatus TEXT,
    sortingOrder INT,
    mediaId INT,
    FOREIGN KEY(mediaId) REFERENCES media(primaryId)
);

CREATE TABLE specimen (
    uuid TEXT UNIQUE NOT NULL PRIMARY KEY,
    projectUuid TEXT,
    speciesID INT,
    iDConfidence INT,
    iDMethod TEXT,
    taxonGroup TEXT, -- use for catalog formats
    condition TEXT,
    prepDate TEXT,
    prepTime TEXT,
    collectionDate TEXT,
    collectionTime TEXT,
    captureDate TEXT,
    isRelativeTime INT,
    captureTime TEXT,
    relativeCaptureTime TEXT,
    trapType TEXT,
    methodID TEXT,
    coordinateID INT,
    coordinateExtentMeters REAL, -- v17
    catalogerID TEXT,
    fieldNumber INT,
    projectFieldNumber INT,
    collEventID INT,
    isMultipleCollector INT,
    collPersonnelID INT,
    collMethodID INT,
    museumID TEXT,
    determinerID TEXT REFERENCES personnel(uuid),
    preparatorID TEXT REFERENCES personnel(uuid),
    FOREIGN KEY(projectUuid) REFERENCES project(uuid),
    FOREIGN KEY(catalogerID) REFERENCES personnel(uuid),
    FOREIGN KEY(collPersonnelID) REFERENCES collPersonnel(id),
    FOREIGN KEY(collMethodID) REFERENCES collEffort(id),
    FOREIGN KEY(speciesID) REFERENCES taxonomy(id),
    FOREIGN KEY(collEventID) REFERENCES collEvent(id)
);

CREATE TABLE mammalAttribute (
    specimenUuid TEXT NOT NULL,
    showBatFields INT,
    totalLength REAL,
    tailLength REAL,
    hindFootLength REAL,
    earLength REAL,
    forearm REAL,
    tibia REAL,
    showEchoFields INT,
    echolocation INT,
    frequencyMax REAL,
    frequencyMin REAL,
    frequencyAtMaxEnergy REAL,
    duration REAL,
    weight REAL,
    weightUnit TEXT,
    accuracy TEXT,
    accuracySpecify TEXT,
    sex INT,
    lifeStage TEXT,
    testisPosition INT, -- encode using enum
    testisLength REAL,
    testisWidth REAL,
    epididymisAppearance INT,
    reproductiveStage INT,
    leftPlacentalScars INT,
    rightPlacentalScars INT,
    mammaeCondition INT,
    mammaeInguinalCount INT,
    mammaeAxillaryCount INT,
    mammaeAbdominalCount INT,
    vaginaOpening INT,
    pubicSymphysis INT,
    embryoLeftCount INT,
    embryoRightCount INT,
    embryoCR INT,
    remark TEXT,
    FOREIGN KEY(specimenUuid) REFERENCES specimen(uuid)
);

CREATE TABLE birdAttribute (
    specimenUuid TEXT NOT NULL,
    weight REAL,
    weightUnit TEXT,
    wingspan REAL,
    irisColor TEXT,
    irisHex TEXT, -- Hex number for iris color
    billColor TEXT,
    billHex TEXT,
    maxillaColor TEXT,
    maxillaHex TEXT,
    mandibleColor TEXT,
    mandibleHex TEXT,
    toeColor TEXT,
    toeHex TEXT,
    tarsusColor TEXT,
    tarsusHex TEXT,
    sex INT,
    lifeStage TEXT,
    broodPatch INT,
    skullOssification INT,
    hasBursa INT,
    bursaWidth REAL,
    bursaLength REAL,
    fat INT,
    stomachContent TEXT,
    testisLength REAL,
    testisWidth REAL,
    testisRemark TEXT,
    ovaryLength REAL,
    ovaryWidth REAL,
    oviductWidth REAL,
    ovaryAppearance INT,
    firstOvaSize REAL,
    secondOvaSize REAL,
    thirdOvaSize REAL,
    oviductAppearance INT, -- encode to int to save space
    ovaryRemark TEXT,
    wingIsMolt INT, -- encode text
    wingMolt TEXT,
    tailIsMolt INT,
    tailMolt TEXT,
    bodyMolt INT, -- encode text
    moltRemark TEXT,
    specimenRemark TEXT,
    habitatRemark TEXT,
    FOREIGN KEY(specimenUuid) REFERENCES specimen(uuid)
);

CREATE TABLE herpAttribute (
    specimenUuid TEXT NOT NULL,
    sex INT,
    lifeStage TEXT,
    weight REAL,
    weightUnit TEXT,
    svl REAL,
    remark TEXT,
    FOREIGN KEY(specimenUuid) REFERENCES specimen(uuid)
);

CREATE TABLE arthropodAttribute (
    specimenUuid TEXT NOT NULL,
    headWidth REAL,
    bodyLength REAL,
    wingspanUpper REAL,
    wingspanLower REAL,
    sex INT,
    lifeStage TEXT,
    caste INT,
    hostOrganism TEXT,
    hostPart TEXT,
    remark TEXT,
    FOREIGN KEY(specimenUuid) REFERENCES specimen(uuid)
);

CREATE TABLE fossilAttribute (
    specimenUuid TEXT NOT NULL,
    fossilType TEXT,
    sex INT,
    ontogeneticStage TEXT,
    weight REAL,
    weightUnit TEXT,
    specimenDescription TEXT,
    remark TEXT,
    FOREIGN KEY(specimenUuid) REFERENCES specimen(uuid)
);

CREATE TABLE parasiteDetection (
    specimenUuid TEXT NOT NULL,
    parasiteExamined INT,
    parasiteDetected INT,
    detectionRemark TEXT,
    FOREIGN KEY(specimenUuid) REFERENCES specimen(uuid)
);

CREATE TABLE parasite (
    id INT UNIQUE PRIMARY KEY AUTOINCREMENT, -- internal id
    specimenUuid TEXT,
    speciesID INT,
    identifierID TEXT REFERENCES personnel(uuid),
    parasiteID TEXT, -- user defined ID similar to specimen part
    parasiteUuid TEXT NOT NULL,
    count INT,
    preparationMethod TEXT,
    storage TEXT,
    storageLocation TEXT,
    treatment TEXT,
    anatomicalLocation TEXT,
    lifeStage TEXT,
    category TEXT, -- endoparasite, ectoparasite, mesoparasite, parasitoid
    associationStatus INT,
    detectionMethod TEXT,
    dateCollected TEXT,
    timeCollected TEXT,
    datePreserved TEXT,
    timePreserved TEXT,
    museumPermanent TEXT,
    museumLoan TEXT,
    remark TEXT,
    FOREIGN KEY(specimenUuid) REFERENCES specimen(uuid),
    FOREIGN KEY(speciesID) REFERENCES taxonomy(id)
);

CREATE TABLE specimenPart (
    id INT UNIQUE PRIMARY KEY AUTOINCREMENT, -- internal id
    specimenUuid TEXT,
    personnelId TEXT,
    tissueID TEXT,
    barcodeID TEXT,
    type TEXT,
    count TEXT,
    treatment TEXT,
    additionalTreatment TEXT,
    storage TEXT,
    storageLocation TEXT,
    dateTaken TEXT,
    timeTaken TEXT,
    pmi TEXT,
    museumPermanent TEXT,
    museumLoan TEXT,
    remark TEXT,
    FOREIGN KEY(specimenUuid) REFERENCES specimen(uuid),
    FOREIGN KEY(personnelId) REFERENCES personnel(uuid)
);

CREATE TABLE customFieldDefinition (
    id INT UNIQUE PRIMARY KEY AUTOINCREMENT, -- internal id
    uuid TEXT NOT NULL UNIQUE,
    sourceTemplateUuid TEXT,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    uiSection TEXT NOT NULL,
    options TEXT,
    scope TEXT NOT NULL,
    projectUuid TEXT,
    catalogFormat TEXT,
    sortOrder INT NOT NULL DEFAULT 0,
    isArchived INT NOT NULL DEFAULT 0 CHECK (isArchived IN (0, 1)),
    dwcTarget TEXT,
    dwcField TEXT,
    dwcMode TEXT,
    allowDwcConflict INT NOT NULL DEFAULT 0 CHECK (allowDwcConflict IN (0, 1)),
    createdAt TEXT,
    updatedAt TEXT,
    FOREIGN KEY(projectUuid) REFERENCES project(uuid) ON DELETE CASCADE,
    CHECK (
      (scope = 'global' AND projectUuid IS NULL) OR
      (scope = 'project' AND projectUuid IS NOT NULL)
    ),
    CHECK (uiSection != 'siteAttribute' OR catalogFormat IS NULL),
    CHECK (
      (dwcTarget IS NULL AND dwcField IS NULL AND dwcMode IS NULL) OR
      (dwcTarget IS NOT NULL AND dwcField IS NOT NULL AND dwcMode IS NOT NULL)
    )
);

CREATE TABLE customFieldValue (
    id INT UNIQUE PRIMARY KEY AUTOINCREMENT, -- internal id
    fieldDefinitionId INT NOT NULL,
    projectUuid TEXT,
    value TEXT NOT NULL,
    unit TEXT,
    eventId INT,
    siteId INT,
    specimenUuid TEXT,
    specimenPartId INT,
    parasiteId INT,
    isLegacy INT NOT NULL DEFAULT 0 CHECK (isLegacy IN (0, 1)),
    FOREIGN KEY(fieldDefinitionId) REFERENCES customFieldDefinition(id) ON DELETE CASCADE,
    FOREIGN KEY(projectUuid) REFERENCES project(uuid) ON DELETE CASCADE,
    FOREIGN KEY(eventId) REFERENCES collEvent(id) ON DELETE CASCADE,
    FOREIGN KEY(siteId) REFERENCES site(id) ON DELETE CASCADE,
    FOREIGN KEY(specimenUuid) REFERENCES specimen(uuid) ON DELETE CASCADE,
    FOREIGN KEY(specimenPartId) REFERENCES specimenPart(id) ON DELETE CASCADE,
    FOREIGN KEY(parasiteId) REFERENCES parasite(id) ON DELETE CASCADE,
    CHECK (
      (isLegacy = 1 AND
        eventId IS NULL AND siteId IS NULL AND specimenUuid IS NULL AND
        specimenPartId IS NULL AND parasiteId IS NULL) OR
      (isLegacy = 0 AND projectUuid IS NOT NULL AND
        ((eventId IS NOT NULL) + (siteId IS NOT NULL) +
         (specimenUuid IS NOT NULL) +
         (specimenPartId IS NOT NULL) + (parasiteId IS NOT NULL)) = 1)
    )
);

CREATE UNIQUE INDEX IF NOT EXISTS custom_field_site_value_idx
ON customFieldValue(fieldDefinitionId, siteId) WHERE siteId IS NOT NULL;

CREATE UNIQUE INDEX IF NOT EXISTS custom_field_event_value_idx
ON customFieldValue(fieldDefinitionId, eventId) WHERE eventId IS NOT NULL;

CREATE UNIQUE INDEX IF NOT EXISTS custom_field_specimen_value_idx
ON customFieldValue(fieldDefinitionId, specimenUuid) WHERE specimenUuid IS NOT NULL;

CREATE UNIQUE INDEX IF NOT EXISTS custom_field_part_value_idx
ON customFieldValue(fieldDefinitionId, specimenPartId) WHERE specimenPartId IS NOT NULL;

CREATE UNIQUE INDEX IF NOT EXISTS custom_field_parasite_value_idx
ON customFieldValue(fieldDefinitionId, parasiteId) WHERE parasiteId IS NOT NULL;

CREATE UNIQUE INDEX IF NOT EXISTS custom_field_template_target_idx
ON customFieldDefinition(sourceTemplateUuid, scope, ifnull(projectUuid, ''))
WHERE sourceTemplateUuid IS NOT NULL;

CREATE TRIGGER custom_field_value_validate_insert
BEFORE INSERT ON customFieldValue
WHEN NEW.isLegacy = 0
BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1
    FROM customFieldDefinition d
    WHERE d.id = NEW.fieldDefinitionId
      AND d.uiSection = CASE
        WHEN NEW.eventId IS NOT NULL THEN 'environmentalData'
        WHEN NEW.siteId IS NOT NULL THEN 'siteAttribute'
        WHEN NEW.specimenUuid IS NOT NULL THEN 'specimenAttribute'
        WHEN NEW.specimenPartId IS NOT NULL THEN 'specimenPart'
        WHEN NEW.parasiteId IS NOT NULL THEN 'parasite'
      END
      AND (d.scope = 'global' OR d.projectUuid = NEW.projectUuid)
  ) THEN RAISE(ABORT, 'Custom field definition does not match its value owner') END;

  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM customFieldDefinition d
    WHERE d.id = NEW.fieldDefinitionId
      AND (
        (NEW.eventId IS NOT NULL AND EXISTS (
          SELECT 1 FROM collEvent e
          WHERE e.id = NEW.eventId AND e.projectUuid = NEW.projectUuid
        )) OR
        (NEW.siteId IS NOT NULL AND EXISTS (
          SELECT 1 FROM site s
          WHERE s.id = NEW.siteId AND s.projectUuid = NEW.projectUuid
        )) OR
        (NEW.specimenUuid IS NOT NULL AND EXISTS (
          SELECT 1 FROM specimen s
          WHERE s.uuid = NEW.specimenUuid AND s.projectUuid = NEW.projectUuid
            AND (d.catalogFormat IS NULL OR d.catalogFormat = CASE lower(s.taxonGroup)
              WHEN 'birds' THEN 'birds'
              WHEN 'herpetofauna' THEN 'herpetofauna'
              WHEN 'arthropods' THEN 'arthropods'
              ELSE 'mammals' END)
        )) OR
        (NEW.specimenPartId IS NOT NULL AND EXISTS (
          SELECT 1 FROM specimenPart p JOIN specimen s ON s.uuid = p.specimenUuid
          WHERE p.id = NEW.specimenPartId AND s.projectUuid = NEW.projectUuid
            AND (d.catalogFormat IS NULL OR d.catalogFormat = CASE lower(s.taxonGroup)
              WHEN 'birds' THEN 'birds'
              WHEN 'herpetofauna' THEN 'herpetofauna'
              WHEN 'arthropods' THEN 'arthropods'
              ELSE 'mammals' END)
        )) OR
        (NEW.parasiteId IS NOT NULL AND EXISTS (
          SELECT 1 FROM parasite p JOIN specimen s ON s.uuid = p.specimenUuid
          WHERE p.id = NEW.parasiteId AND s.projectUuid = NEW.projectUuid
            AND (d.catalogFormat IS NULL OR d.catalogFormat = CASE lower(s.taxonGroup)
              WHEN 'birds' THEN 'birds'
              WHEN 'herpetofauna' THEN 'herpetofauna'
              WHEN 'arthropods' THEN 'arthropods'
              ELSE 'mammals' END)
        ))
      )
  ) THEN RAISE(ABORT, 'Custom field value project or catalog does not match its owner') END;
END;

CREATE TRIGGER custom_field_value_validate_update
BEFORE UPDATE ON customFieldValue
WHEN NEW.isLegacy = 0
BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1
    FROM customFieldDefinition d
    WHERE d.id = NEW.fieldDefinitionId
      AND d.uiSection = CASE
        WHEN NEW.eventId IS NOT NULL THEN 'environmentalData'
        WHEN NEW.siteId IS NOT NULL THEN 'siteAttribute'
        WHEN NEW.specimenUuid IS NOT NULL THEN 'specimenAttribute'
        WHEN NEW.specimenPartId IS NOT NULL THEN 'specimenPart'
        WHEN NEW.parasiteId IS NOT NULL THEN 'parasite'
      END
      AND (d.scope = 'global' OR d.projectUuid = NEW.projectUuid)
  ) THEN RAISE(ABORT, 'Custom field definition does not match its value owner') END;

  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM customFieldDefinition d
    WHERE d.id = NEW.fieldDefinitionId
      AND (
        (NEW.eventId IS NOT NULL AND EXISTS (
          SELECT 1 FROM collEvent e
          WHERE e.id = NEW.eventId AND e.projectUuid = NEW.projectUuid
        )) OR
        (NEW.siteId IS NOT NULL AND EXISTS (
          SELECT 1 FROM site s
          WHERE s.id = NEW.siteId AND s.projectUuid = NEW.projectUuid
        )) OR
        (NEW.specimenUuid IS NOT NULL AND EXISTS (
          SELECT 1 FROM specimen s
          WHERE s.uuid = NEW.specimenUuid AND s.projectUuid = NEW.projectUuid
            AND (d.catalogFormat IS NULL OR d.catalogFormat = CASE lower(s.taxonGroup)
              WHEN 'birds' THEN 'birds'
              WHEN 'herpetofauna' THEN 'herpetofauna'
              WHEN 'arthropods' THEN 'arthropods'
              ELSE 'mammals' END)
        )) OR
        (NEW.specimenPartId IS NOT NULL AND EXISTS (
          SELECT 1 FROM specimenPart p JOIN specimen s ON s.uuid = p.specimenUuid
          WHERE p.id = NEW.specimenPartId AND s.projectUuid = NEW.projectUuid
            AND (d.catalogFormat IS NULL OR d.catalogFormat = CASE lower(s.taxonGroup)
              WHEN 'birds' THEN 'birds'
              WHEN 'herpetofauna' THEN 'herpetofauna'
              WHEN 'arthropods' THEN 'arthropods'
              ELSE 'mammals' END)
        )) OR
        (NEW.parasiteId IS NOT NULL AND EXISTS (
          SELECT 1 FROM parasite p JOIN specimen s ON s.uuid = p.specimenUuid
          WHERE p.id = NEW.parasiteId AND s.projectUuid = NEW.projectUuid
            AND (d.catalogFormat IS NULL OR d.catalogFormat = CASE lower(s.taxonGroup)
              WHEN 'birds' THEN 'birds'
              WHEN 'herpetofauna' THEN 'herpetofauna'
              WHEN 'arthropods' THEN 'arthropods'
              ELSE 'mammals' END)
        ))
      )
  ) THEN RAISE(ABORT, 'Custom field value project or catalog does not match its owner') END;
END;

CREATE INDEX IF NOT EXISTS specimen_project_species_idx
ON specimen(projectUuid, speciesID);

CREATE INDEX IF NOT EXISTS specimen_project_event_idx
ON specimen(projectUuid, collEventID);

CREATE INDEX IF NOT EXISTS site_project_idx
ON site(projectUuid);

CREATE INDEX IF NOT EXISTS site_geography_idx
ON site(geographyId);

CREATE INDEX IF NOT EXISTS coordinate_site_idx
ON coordinate(siteID);

CREATE INDEX IF NOT EXISTS specimen_project_coordinate_idx
ON specimen(projectUuid, coordinateID);

CREATE INDEX IF NOT EXISTS coll_event_project_site_idx
ON collEvent(projectUuid, siteID);

CREATE INDEX IF NOT EXISTS specimen_part_specimen_idx
ON specimenPart(specimenUuid);

CREATE INDEX IF NOT EXISTS associated_data_project_idx
ON associatedData(projectUuid);

CREATE INDEX IF NOT EXISTS specimen_associated_data_data_idx
ON specimenAssociatedData(associatedDataId);

CREATE INDEX IF NOT EXISTS site_associated_data_data_idx
ON siteAssociatedData(associatedDataId);

CREATE INDEX IF NOT EXISTS event_associated_data_data_idx
ON eventAssociatedData(associatedDataId);

CREATE UNIQUE INDEX IF NOT EXISTS parasite_detection_specimen_idx
ON parasiteDetection(specimenUuid);

CREATE INDEX IF NOT EXISTS parasite_specimen_idx
ON parasite(specimenUuid);

CREATE UNIQUE INDEX IF NOT EXISTS parasite_uuid_idx
ON parasite(parasiteUuid);
